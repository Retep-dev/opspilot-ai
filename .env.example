# Local placeholders only. Copy to .env and supply your own development values.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://opspilot:replace-with-local-password@db:5432/opspilot
NVIDIA_NIM_API_KEY=replace-with-local-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_URL=https://ai.api.nvidia.com/v1/retrieval/nvidia/embeddings
NVIDIA_CHAT_MODEL=replace-with-supported-chat-model
NVIDIA_EMBEDDING_MODEL=replace-with-1024-dimension-embedding-model
OIDC_ISSUER=https://replace-with-your-issuer.example
OIDC_AUDIENCE=replace-with-api-audience
OIDC_JWKS_URL=https://replace-with-your-issuer.example/.well-known/jwks.json
SLACK_BOT_TOKEN=replace-with-local-token
RESEND_API_KEY=replace-with-local-key
EMAIL_FROM=replace-with-verified-sender@example.com
APP_ENV=development
