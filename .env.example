# Local placeholders only. Copy to .env and supply your own development values.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://opspilot:replace-with-local-password@db:5432/opspilot
# Optional disposable test database; never point this at production.
TEST_DATABASE_URL=postgresql://opspilot:replace-with-test-password@localhost:5432/opspilot_test
NVIDIA_NIM_API_KEY=replace-with-local-key
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBEDDING_URL=https://integrate.api.nvidia.com/v1/embeddings
NVIDIA_CHAT_MODEL=z-ai/glm-5.3
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
OIDC_ISSUER=https://replace-with-your-issuer.example
OIDC_AUDIENCE=replace-with-api-audience
OIDC_JWKS_URL=https://replace-with-your-issuer.example/.well-known/jwks.json
SLACK_BOT_TOKEN=replace-with-local-token
RESEND_API_KEY=replace-with-local-key
EMAIL_FROM=replace-with-verified-sender@example.com
SLACK_TEST_CHANNEL_ID=replace-with-test-channel-id
TEST_RECIPIENT_EMAIL=replace-with-test-recipient@example.com
OPSPILOT_LIVE_TEST_MODE=false
APP_ENV=development
